{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeout.example/schemas/vo-personas-simulation/entity-contracts.schema.json",
  "title": "VO Personas Simulation Entity Contract Catalog",
  "description": "Architecture-level JSON Schema definitions for persistent simulation, listening, tracking, emotional history, audit, analytics, and affinity entities. These definitions describe logical records, not per-person files.",
  "oneOf": [
    { "$ref": "#/$defs/SimulationConfig" },
    { "$ref": "#/$defs/SimulationInstance" },
    { "$ref": "#/$defs/ExecutionBatch" },
    { "$ref": "#/$defs/Checkpoint" },
    { "$ref": "#/$defs/PersonaProfile" },
    { "$ref": "#/$defs/PersonaStateCurrent" },
    { "$ref": "#/$defs/PersonaSchedule" },
    { "$ref": "#/$defs/ScheduleTemplate" },
    { "$ref": "#/$defs/LifeEvent" },
    { "$ref": "#/$defs/WorldState" },
    { "$ref": "#/$defs/Artist" },
    { "$ref": "#/$defs/Track" },
    { "$ref": "#/$defs/PersonTrackState" },
    { "$ref": "#/$defs/PersonArtistState" },
    { "$ref": "#/$defs/ExposurePolicy" },
    { "$ref": "#/$defs/ContextSnapshot" },
    { "$ref": "#/$defs/SimulationFrame" },
    { "$ref": "#/$defs/ListeningIntent" },
    { "$ref": "#/$defs/ExposureSet" },
    { "$ref": "#/$defs/CandidateEvaluation" },
    { "$ref": "#/$defs/PlaybackSessionState" },
    { "$ref": "#/$defs/ObservableEvent" },
    { "$ref": "#/$defs/ListeningSession" },
    { "$ref": "#/$defs/StateTransition" },
    { "$ref": "#/$defs/EmotionalStateObservation" },
    { "$ref": "#/$defs/OracleDecisionTrace" },
    { "$ref": "#/$defs/DailyPersonaSummary" },
    { "$ref": "#/$defs/SimulationMetrics" },
    { "$ref": "#/$defs/SocialEdge" },
    { "$ref": "#/$defs/AffinityCalculation" },
    { "$ref": "#/$defs/AffinityScore" }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "UnitInterval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "SignedUnitInterval": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "EmotionVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valence", "arousal", "dominance", "intensity", "primary_label"],
      "properties": {
        "valence": { "$ref": "#/$defs/SignedUnitInterval" },
        "arousal": { "$ref": "#/$defs/UnitInterval" },
        "dominance": { "$ref": "#/$defs/UnitInterval" },
        "intensity": { "$ref": "#/$defs/UnitInterval" },
        "primary_label": { "type": "string" },
        "secondary_labels": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "ApplicationContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device_type": { "type": "string" },
        "operating_system": { "type": "string" },
        "app_version": { "type": "string" },
        "surface": { "type": "string" },
        "request_id": { "type": ["string", "null"] },
        "network_type": { "type": ["string", "null"] }
      }
    },
    "SimulationLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["simulation_id", "execution_id"],
      "properties": {
        "simulation_id": { "$ref": "#/$defs/Identifier" },
        "execution_id": { "$ref": "#/$defs/Identifier" },
        "decision_sequence": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "StateChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operation"],
      "properties": {
        "path": { "type": "string" },
        "operation": { "enum": ["set", "increment", "decrement", "append", "remove"] },
        "before": {},
        "after": {},
        "delta": {}
      }
    },
    "ExposureItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_id", "position", "source", "served"],
      "properties": {
        "track_id": { "$ref": "#/$defs/Identifier" },
        "position": { "type": "integer", "minimum": 0 },
        "source": { "type": "string" },
        "served": { "type": "boolean" },
        "ranking_score": { "type": ["number", "null"] },
        "reason_code": { "type": ["string", "null"] }
      }
    },
    "SimulationConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "scenario_id", "config_version", "schema_version", "clock", "model_versions", "retention_policy"],
      "properties": {
        "entity_type": { "const": "SimulationConfig" },
        "scenario_id": { "$ref": "#/$defs/Identifier" },
        "config_version": { "type": "string" },
        "schema_version": { "type": "string" },
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tick_minutes", "timezone"],
          "properties": {
            "tick_minutes": { "type": "integer", "minimum": 1 },
            "timezone": { "type": "string" },
            "default_advance_minutes": { "type": "integer", "minimum": 1 }
          }
        },
        "model_versions": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "policy_versions": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "emotional_observation_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "heartbeat_minutes": { "type": ["integer", "null"], "minimum": 1 },
            "record_session_boundaries": { "type": "boolean" },
            "record_life_event_boundaries": { "type": "boolean" },
            "change_threshold": { "$ref": "#/$defs/UnitInterval" }
          }
        },
        "retention_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["audit_mode"],
          "properties": {
            "audit_mode": { "enum": ["lean", "standard", "forensic"] },
            "checkpoint_interval_hours": { "type": "integer", "minimum": 1 },
            "full_frame_persona_allowlist": {
              "type": "array",
              "items": { "$ref": "#/$defs/Identifier" },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "SimulationInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "simulation_id", "scenario_id", "config_version", "status", "logical_time", "simulation_seed", "frozen_versions", "created_at"],
      "properties": {
        "entity_type": { "const": "SimulationInstance" },
        "simulation_id": { "$ref": "#/$defs/Identifier" },
        "scenario_id": { "$ref": "#/$defs/Identifier" },
        "config_version": { "type": "string" },
        "status": { "enum": ["initialising", "active", "paused", "completed", "failed", "archived"] },
        "logical_time": { "$ref": "#/$defs/Timestamp" },
        "simulation_seed": { "type": "integer" },
        "population_id": { "$ref": "#/$defs/Identifier" },
        "parent_simulation_id": { "type": ["string", "null"] },
        "parent_checkpoint_id": { "type": ["string", "null"] },
        "frozen_versions": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "created_at": { "$ref": "#/$defs/Timestamp" },
        "updated_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "ExecutionBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "execution_id", "simulation_id", "status", "logical_from", "logical_to", "started_at"],
      "properties": {
        "entity_type": { "const": "ExecutionBatch" },
        "execution_id": { "$ref": "#/$defs/Identifier" },
        "simulation_id": { "$ref": "#/$defs/Identifier" },
        "status": { "enum": ["pending", "running", "completed", "partially_failed", "failed"] },
        "logical_from": { "$ref": "#/$defs/Timestamp" },
        "logical_to": { "$ref": "#/$defs/Timestamp" },
        "started_at": { "$ref": "#/$defs/Timestamp" },
        "completed_at": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "attempt": { "type": "integer", "minimum": 1 },
        "worker_version": { "type": "string" },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "due": { "type": "integer", "minimum": 0 },
            "processed": { "type": "integer", "minimum": 0 },
            "deferred": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "events_emitted": { "type": "integer", "minimum": 0 }
          }
        },
        "error_summary": { "type": ["string", "null"] }
      }
    },
    "Checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "checkpoint_id", "simulation_id", "logical_time", "created_at", "storage_ref", "content_hash", "versions"],
      "properties": {
        "entity_type": { "const": "Checkpoint" },
        "checkpoint_id": { "$ref": "#/$defs/Identifier" },
        "simulation_id": { "$ref": "#/$defs/Identifier" },
        "execution_id": { "$ref": "#/$defs/Identifier" },
        "logical_time": { "$ref": "#/$defs/Timestamp" },
        "created_at": { "$ref": "#/$defs/Timestamp" },
        "storage_ref": { "type": "string" },
        "content_hash": { "type": "string" },
        "event_offsets": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "versions": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "PersonaProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "persona_id", "profile_version", "demographics", "psychology", "emotional_profile", "musical_identity", "life_context", "created_at"],
      "properties": {
        "entity_type": { "const": "PersonaProfile" },
        "persona_id": { "$ref": "#/$defs/Identifier" },
        "profile_version": { "type": "integer", "minimum": 1 },
        "archetype_id": { "type": ["string", "null"] },
        "demographics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "age": { "type": "integer", "minimum": 13 },
            "country_code": { "type": "string" },
            "primary_language": { "type": "string" },
            "location_id": { "$ref": "#/$defs/Identifier" },
            "education_level": { "type": ["string", "null"] }
          }
        },
        "psychology": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "personality": { "type": "object", "additionalProperties": { "$ref": "#/$defs/UnitInterval" } },
            "emotion_regulation_preferences": { "type": "object", "additionalProperties": { "$ref": "#/$defs/UnitInterval" } },
            "uncertainty_tolerance": { "$ref": "#/$defs/UnitInterval" },
            "self_awareness": { "$ref": "#/$defs/UnitInterval" }
          }
        },
        "emotional_profile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseline": { "$ref": "#/$defs/EmotionVector" },
            "inertia": { "$ref": "#/$defs/UnitInterval" },
            "volatility": { "$ref": "#/$defs/UnitInterval" },
            "music_receptiveness": { "$ref": "#/$defs/UnitInterval" },
            "reporting_accuracy": { "$ref": "#/$defs/UnitInterval" }
          }
        },
        "musical_identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "genre_affinities": { "type": "object", "additionalProperties": { "$ref": "#/$defs/SignedUnitInterval" } },
            "novelty_preference": { "$ref": "#/$defs/UnitInterval" },
            "familiarity_preference": { "$ref": "#/$defs/UnitInterval" },
            "music_importance": { "$ref": "#/$defs/UnitInterval" },
            "preferred_listening_functions": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          }
        },
        "life_context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "employment_status": { "type": "string" },
            "household_type": { "type": "string" },
            "relationship_status": { "type": "string" },
            "financial_pressure_baseline": { "$ref": "#/$defs/UnitInterval" },
            "family_pressure_baseline": { "$ref": "#/$defs/UnitInterval" },
            "ambition_level": { "$ref": "#/$defs/UnitInterval" }
          }
        },
        "created_at": { "$ref": "#/$defs/Timestamp" },
        "valid_from": { "$ref": "#/$defs/Timestamp" },
        "valid_to": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] }
      }
    },
    "PersonaStateCurrent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "simulation_id", "persona_id", "state_version", "as_of", "emotion", "energy", "fatigue", "stress", "attention", "satisfaction", "recent_emotional_features", "next_scheduled_event_at"],
      "properties": {
        "entity_type": { "const": "PersonaStateCurrent" },
        "simulation_id": { "$ref": "#/$defs/Identifier" },
        "persona_id": { "$ref": "#/$defs/Identifier" },
        "profile_version": { "type": "integer", "minimum": 1 },
        "state_version": { "type": "integer", "minimum": 0 },
        "as_of": { "$ref": "#/$defs/Timestamp" },
        "emotion": { "$ref": "#/$defs/EmotionVector" },
        "energy": { "$ref": "#/$defs/UnitInterval" },
        "fatigue": { "$ref": "#/$defs/UnitInterval" },
        "stress": { "$ref": "#/$defs/UnitInterval" },
        "attention": { "$ref": "#/$defs/UnitInterval" },
        "satisfaction": { "$ref": "#/$defs/UnitInterval" },
        "current_activity": { "type": "string" },
        "active_goal_ids": { "type": "array", "items": { "$ref": "#/$defs/Identifier" }, "uniqueItems": true },
        "active_life_event_ids": { "type": "array", "items": { "$ref": "#/$defs/Identifier" }, "uniqueItems": true },
        "recent_emotional_features": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valence_trend", "arousal_trend", "volatility", "state_duration_minutes"],
          "properties": {
            "valence_trend": { "$ref": "#/$defs/SignedUnitInterval" },
            "arousal_trend": { "$ref": "#/$defs/SignedUnitInterval" },
            "volatility": { "$ref": "#/$defs/UnitInterval" },
            "state_duration_minutes": { "type": "integer", "minimum": 0 },
            "recent_regulation_success": { "$ref": "#/$defs/UnitInterval" }
          }
        },
        "last_session_id": { "type": ["string", "null"] },
        "last_observation_at": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "next_scheduled_event_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "PersonaSchedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "persona_id", "schedule_version", "schedule_template_id", "timezone", "overrides"],
      "properties": {
        "entity_type": { "const": "PersonaSchedule" },
        "persona_id": { "$ref": "#/$defs/Identifier" },
        "schedule_version": { "type": "integer", "minimum": 1 },
        "schedule_template_id": { "$ref": "#/$defs/Identifier" },
        "timezone": { "type": "string" },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["day", "start_local_time", "activity", "probability"],
            "properties": {
              "day": { "type": "string" },
              "start_local_time": { "type": "string" },
              "duration_minutes": { "type": "integer", "minimum": 1 },
              "activity": { "type": "string" },
              "probability": { "$ref": "#/$defs/UnitInterval" }
            }
          }
        }
      }
    },
    "ScheduleTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "schedule_template_id", "template_version", "name", "activity_windows"],
      "properties": {
        "entity_type": { "const": "ScheduleTemplate" },
        "schedule_template_id": { "$ref": "#/$defs/Identifier" },
        "template_version": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "activity_windows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["days", "start_local_time", "activity", "probability"],
            "properties": {
              "days": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "start_local_time": { "type": "string" },
              "duration_minutes": { "type": "integer", "minimum": 1 },
              "activity": { "type": "string" },
              "probability": { "$ref": "#/$defs/UnitInterval" }
            }
          }
        }
      }
    },
    "LifeEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "life_event_id", "simulation_id", "persona_id", "event_type", "starts_at", "status", "intensity", "effects"],
      "properties": {
        "entity_type": { "const": "LifeEvent" },
        "life_event_id": { "$ref": "#/$defs/Identifier" },
        "simulation_id": { "$ref": "#/$defs/Identifier" },
        "persona_id": { "$ref": "#/$defs/Identifier" },
        "event_type": { "type": "string" },
        "starts_at": { "$ref": "#/$defs/Timestamp" },
        "ends_at": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "status": { "enum": ["scheduled", "active", "resolved", "cancelled"] },
        "intensity": { "$ref": "#/$defs/UnitInterval" },
        "effects": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "source": { "enum": ["generated", "scenario", "derived"] }
      }
    },
    "WorldState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "location_id", "time_bucket", "weather", "daylight", "season", "trend_context"],
      "properties": {
        "entity_type": { "const": "WorldState" },
        "location_id": { "$ref": "#/$defs/Identifier" },
        "time_bucket": { "$ref": "#/$defs/Timestamp" },
        "weather": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "condition": { "type": "string" },
            "temperature_c": { "type": "number" },
            "precipitation_probability": { "$ref": "#/$defs/UnitInterval" }
          }
        },
        "daylight": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "is_daylight": { "type": "boolean" },
            "minutes_since_sunrise": { "type": ["integer", "null"] },
            "minutes_until_sunset": { "type": ["integer", "null"] }
          }
        },
        "season": { "type": "string" },
        "holiday_id": { "type": ["string", "null"] },
        "trend_context": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    },
    "Artist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "artist_id", "artist_version", "name", "genres"],
      "properties": {
        "entity_type": { "const": "Artist" },
        "artist_id": { "$ref": "#/$defs/Identifier" },
        "artist_version": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "genres": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "origin_country": { "type": ["string", "null"] },
        "catalogue_popularity": { "$ref": "#/$defs/UnitInterval" }
      }
    },
    "Track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "track_id", "track_version", "artist_id", "title", "duration_ms", "genres", "audio_features", "emotion_profile", "availability"],
      "properties": {
        "entity_type": { "const": "Track" },
        "track_id": { "$ref": "#/$defs/Identifier" },
        "track_version": { "type": "integer", "minimum": 1 },
        "artist_id": { "$ref": "#/$defs/Identifier" },
        "title": { "type": "string" },
        "duration_ms": { "type": "integer", "minimum": 1 },
        "genres": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "languages": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "audio_features": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tempo_bpm": { "type": "number", "minimum": 0 },
            "energy": { "$ref": "#/$defs/UnitInterval" },
            "danceability": { "$ref": "#/$defs/UnitInterval" },
            "acousticness": { "$ref": "#/$defs/UnitInterval" },
            "instrumentalness": { "$ref": "#/$defs/UnitInterval" }
          }
        },
        "emotion_profile": { "$ref": "#/$defs/EmotionVector" },
        "lyrical_themes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "active": { "type": "boolean" },
            "market_codes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          }
        }
      }
    },
    "PersonTrackState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "simulation_id", "persona_id", "track_id", "state_version", "familiarity", "learned_affinity", "satiation", "exposure_count", "play_count", "updated_at"],
      "properties": {
        "entity_type": { "const": "PersonTrackState" },
        "simulation_id": { "$ref": "#/$defs/Identifier" },
        "persona_id": { "$ref": "#/$defs/Identifier" },
        "track_id": { "$ref": "#/$defs/Identifier" },
        "state_version": { "type": "integer", "minimum": 1 },
        "familiarity": { "$ref": "#/$defs/UnitInterval" },
        "learned_affinity": { "$ref": "#/$defs/SignedUnitInterval" },
        "satiation": { "$ref": "#/$defs/UnitInterval" },
        "emotional_associations": { "type": "object", "additionalProperties": { "type": "number" } },
        "exposure_count": { "type": "integer", "minimum": 0 },
        "play_count": { "type": "integer", "minimum": 0 },
        "skip_count": { "type": "integer", "minimum": 0 },
        "last_exposed_at": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "last_played_at": { "anyOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }] },
        "updated_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "PersonArtistState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "simulation_id", "persona_id", "artist_id", "state_version", "familiarity", "learned_affinity", "loyalty", "satiation", "updated_at"],
      "properties": {
        "entity_type": { "const": "PersonArtistState" },
        "simulation_id": { "$ref": "#/$defs/Identifier" },
        "persona_id": { "$ref": "#/$defs/Identifier" },
        "artist_id": { "$ref": "#/$defs/Identifier" },
        "state_version": { "type": "integer", "minimum": 1 },
        "familiarity": { "$ref": "#/$defs/UnitInterval" },
        "learned_affinity": { "$ref": "#/$defs/SignedUnitInterval" },
        "loyalty": { "$ref": "#/$defs/UnitInterval" },
        "satiation": { "$ref": "#/$defs/UnitInterval" },
        "play_count": { "type": "integer", "minimum": 0 },
        "updated_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "ExposurePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "policy_id", "policy_version", "candidate_sources", "ranking_model_version", "max_items", "position_effects"],
      "properties": {
        "entity_type": { "const": "ExposurePolicy" },
